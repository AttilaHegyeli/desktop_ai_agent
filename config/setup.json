{
  "ollama": {
    "base_model": "gemma4",
    "agent_model": "gemma4-agent",
    "host": "http://127.0.0.1:11434",
    "startup_timeout_sec": 60,
    "interactive_commands": [
      "/set nothink",
      "/set format json"
    ]
  },
  "program_files_index": {
    "enabled": true,
    "resolve_exe": true,
    "drives": ["C", "D", "E"]
  },
  "formats": {
    "response_schema": {
      "script": "snake_case job id for Action layer logs/routing",
      "code": "python source Action will exec unchanged"
    }
  },
  "ui": {
    "title": "Desktop AI Agent — Ollama Setup",
    "width": 820,
    "height": 640,
    "auto_open": true
  },
  "voice": {
    "enabled": true,
    "model_size": "base.en",
    "language": "en",
    "sample_rate": 16000,
    "device": "cpu",
    "compute_type": "int8"
  }
}
